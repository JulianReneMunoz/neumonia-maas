# Configuración de neumonia-maas. Copia este archivo a .env y ajusta lo que necesites.
# Prioridad: variable de entorno > .env del directorio de trabajo > valor por defecto.
# Sin secretos: este proyecto no usa tokens ni contraseñas. .env no se sube a Git.

# Modelo de Hugging Face Hub.
NEUMONIA_MODEL_ID=lxyuan/vit-xray-pneumonia-classification
# Revisión del modelo (commit SHA). Provisional: SPEC-005 fija el SHA.
NEUMONIA_MODEL_REVISION=main

# Umbral de decisión: p(PNEUMONIA) >= umbral → PNEUMONIA. Rango 0–1.
NEUMONIA_THRESHOLD=0.5

# Tamaño máximo de la imagen subida, en MB (entero > 0).
NEUMONIA_MAX_UPLOAD_MB=10
# Tiempo máximo de inferencia, en segundos (> 0).
NEUMONIA_TIMEOUT_S=30.0

# Orígenes del frontend permitidos por CORS, separados por comas.
NEUMONIA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Servidor de MLflow (make mlflow).
NEUMONIA_MLFLOW_TRACKING_URI=http://127.0.0.1:5050